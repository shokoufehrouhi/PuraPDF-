<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- PuraPDF+'s own code (not the bundled SDKs, which each ship their
	     own manifest under ios/Pods/.../PrivacyInfo.xcprivacy) doesn't
	     collect or link any data to a person or device - every PDF
	     operation runs on-device and nothing here reports usage
	     externally. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason APIs Runner/AppDelegate.swift and
	     ShareExtension/ShareViewController.swift call directly (see their
	     doc comments) - both only ever touch the app's own sandboxed
	     container or the `group.com.purapdf.purapdf` App Group it shares
	     with the Share Extension, never another app's data. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
