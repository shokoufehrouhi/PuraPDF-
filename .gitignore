# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Belt-and-suspenders for /build/: a `flutter build`/`pod install` run from
# the wrong cwd once created a stray build/ under lib/l10n/, which the
# anchored rule above didn't catch and which also confused `flutter
# analyze` into treating vendored CocoaPods test sources as part of this
# project. Catch a build/ at any depth, not just the root.
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing — never commit the keystore or its credentials.
android/key.properties
*.jks
*.keystore
